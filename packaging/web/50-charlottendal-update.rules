// Lets the web deployment's TKL service start its own update
// (charlottendal-update.service) from the panel, and nothing else.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "charlottendal" &&
        action.lookup("unit") === "charlottendal-update.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});

# Charlottendal TKL on this machine. Written once by the installer; updates keep it.
NODE_ENV=production
# The independent LocoNet simulator. Physical MGP via LocoBuffer is a later phase.
CHARLOTTENDAL_CONNECTION_MODE=simulator
CHARLOTTENDAL_WIRE_HOST=127.0.0.1
CHARLOTTENDAL_WIRE_PORT=8912
CHARLOTTENDAL_PORT=8910
CHARLOTTENDAL_SIM_PORT=8911
CHARLOTTENDAL_STATE_DIR=/var/lib/cda-tkl
CHARLOTTENDAL_FIELD_URL=http://127.0.0.1:8911/
CHARLOTTENDAL_TKL_URL=http://127.0.0.1:8910/
# Installed copy: look for new releases in beahead-ab/cda-tkl-install (raspberry-pi, mac, windows).
CHARLOTTENDAL_INSTALL_KIND=raspberry-pi
# TKL listens on this machine only (127.0.0.1). The operator needs no login here; Inställningar and
# Objekt och regler ask the owner or an administrator to log in (users.json in the state directory).
# Optional fixed TrainMeet server; otherwise it is chosen and paired in the panel.
# CHARLOTTENDAL_TRAINMEET_ORIGIN=https://server.trainmeet.app
